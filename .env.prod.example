# Production configuration for docker-compose.prod.yml — copy to .env on the
# server and fill in. docker compose reads .env automatically.

# Public URL of the instance: the bare origin (scheme + host, no path, no
# trailing slash). Also used for QR codes, short URLs and LTI redirects, and
# it is Caddy's site address (https:// = automatic HTTPS for that host).
PUBLIC_BASE_URL=https://abstimmbar.example.org

# Contact e-mail for Let's Encrypt (certificate expiry notices). Required.
ACME_EMAIL=admin@example.org

# Only for LTI iframe embedding: LMS origin(s) allowed to frame the SPA,
# space-separated. Empty/unset = no external framing. Apply with
# `docker compose -f docker-compose.prod.yml up -d` (recreates caddy).
#ABSTIMMBAR_FRAME_ANCESTORS=https://moodle.example.org

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=abstimmbar.example.org
CSRF_TRUSTED_ORIGINS=https://abstimmbar.example.org

# PostgreSQL
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Frontend build. Optional — the SPA defaults to same-origin, relative API
# URLs (correct behind Caddy). Only set for a deliberately different setup;
# baked in by Vite at build time, so it only takes effect with `up -d --build`
# — a pulled release image was already built with the default.
#VITE_API_BASE_URL=https://abstimmbar.example.org
# Target of the "Guide" entry in the app's ? menu — German UI / English UI.
# Optional, default is the public project website; set them to point at your
# own copy of the guide. Build-time as well (`up -d --build`).
#VITE_GUIDE_URL=https://virtuos.github.io/abstimmbar/anleitung/
#VITE_GUIDE_URL_EN=https://virtuos.github.io/abstimmbar/en/guide/

# Pin a specific released image (see docker-compose.prod.yml's `app`
# service). Unset = latest.
#ABSTIMMBAR_VERSION=v1.2.0

# OIDC — institutional Keycloak. With OIDC_OP_ISSUER set, the endpoints are
# read from the discovery document; explicit OIDC_OP_* values win over it.
OIDC_RP_CLIENT_ID=abstimmbar
OIDC_RP_CLIENT_SECRET=change-me
OIDC_OP_ISSUER=https://sso.example.org/realms/example
# Members of this IdP group get Django admin on login (empty = disabled).
OIDC_ADMIN_GROUP=
OIDC_GROUPS_CLAIM=groups
# Claim names — uncomment only if the IdP uses non-standard ones.
#OIDC_CLAIM_USERNAME=preferred_username
#OIDC_CLAIM_EMAIL=email
#OIDC_CLAIM_FIRST_NAME=given_name
#OIDC_CLAIM_LAST_NAME=family_name
# Heal re-issued IdP subjects by matching on the username. Off by default:
# enable ONLY if your IdP assigns usernames centrally and never re-assigns
# them to different people — otherwise an IdP account could adopt a local
# account of the same username.
#OIDC_MATCH_BY_USERNAME_FALLBACK=1

# Only when the LTI tool must run inside LMS iframes (forces Secure cookies,
# i.e. requires HTTPS): set to None so the session cookie survives being a
# third-party cookie in the iframe. Also set ABSTIMMBAR_FRAME_ANCESTORS (above)
# to the LMS origin (SPA), or embedding stays blocked
# there even though Django allows it for /p/ and /lti/. The recommended
# new-window launch needs neither change — keep the default Lax then.
#SESSION_COOKIE_SAMESITE=None

# Optional AI features via a LiteLLM proxy. Leave AI_PROVIDER=none (or unset)
# to keep everything off. All four (provider/base/key/model) are required for
# AI to switch on. Env is read at startup — recreate the container to apply.
AI_PROVIDER=none
#AI_PROVIDER=litellm
#AI_BASE_URL=https://litellm.example.org/v1
#AI_API_KEY=sk-change-me
#AI_MODEL=qwen-3.5
#AI_TIMEOUT=30
#AI_MAX_TOKENS=2000
# Set to 0 for models that don't support the "disable thinking" hint.
#AI_DISABLE_THINKING=1
# Async "generate questions from a document" job (chunked, background worker):
# chunk size and hard cap on chunks per job. Defaults shown; uncomment to
# override.
#AI_CHUNK_CHARS=12000
#AI_GEN_MAX_CHUNKS=40
# Question generation: safety cap on total questions and default density
# (questions per page). The whole document is covered; density x pages is
# clamped to AI_GEN_MAX_QUESTIONS.
#AI_GEN_MAX_QUESTIONS=150
#AI_GEN_DEFAULT_DENSITY=1.0

# Content i18n (#33). Canonical language of authored content (title/text/…);
# must be one of the supported UI languages (de/en). Existing data was entered
# in German, so keep "de" unless you know what you're doing.
CONTENT_DEFAULT_LANGUAGE=de
# Optional machine-translation pre-fill in the editor (django-modeltranslation
# fields). Off by default; self-host LibreTranslate (Apache-2.0) and point the
# URL at it to enable a "translate from <lang>" button. Never overwrites a
# human translation — it only pre-fills an empty language.
CONTENT_TRANSLATION_PROVIDER=none
#CONTENT_TRANSLATION_PROVIDER=libretranslate
#LIBRETRANSLATE_URL=https://libretranslate.example.org
#LIBRETRANSLATE_API_KEY=change-me

# Uploaded images are downscaled + re-encoded to WebP on upload. Defaults are
# sensible; override only to tune. No change needed for a normal deployment.
#IMAGE_MAX_EDGE=1600
#IMAGE_WEBP_QUALITY=80

# Prometheus metrics endpoint (/metrics). Unset = endpoint returns 404 (off).
# Set a long random token; the scraper sends "Authorization: Bearer <token>".
#METRICS_TOKEN=
